# Telegram worker
BOT_TOKEN=
ADMIN_IDS=
PLUGIN_MODULES=bot_plugins.local.example_plugin
AUTO_HEAL_INTERVAL=15
AUTO_HEAL_MAX_RESTARTS=5
AUTO_HEAL_WINDOW_SECONDS=600
KEEPALIVE_SWEEP_INTERVAL=15
KEEPALIVE_TIMEOUT_SECONDS=10

# TypeScript control plane
PORT=8787
NODE_ENV=development
DATA_DIR=./data
KEEPALIVE_TICK_MS=15000
CORS_ORIGIN=

# For a static dashboard backed by a separate persistent API, set these:
# VITE_API_BASE_URL=https://your-control-plane.example.com
# CORS_ORIGIN=https://your-dashboard.vercel.app
# Set VITE_DEMO_MODE=true only for a standalone static preview.
